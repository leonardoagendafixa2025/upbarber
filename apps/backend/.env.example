# Aplicação
NODE_ENV=production
PORT=3000
TRUST_PROXY=2
# URL(s) do frontend (CORS), separadas por vírgula
FRONTEND_URL=https://seu-app.vercel.app
# domínio base da plataforma (CORS para subdomínios)
PLATFORM_DOMAIN=
# URL pública da API
API_PUBLIC_URL=https://seu-backend.railway.app

# Banco de dados (Supabase)
# Para produção via pooler (Transaction mode - porta 6543):
DATABASE_URL=postgresql://postgres.[REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true
# URL direta para migrations do Prisma (porta 5432):
DIRECT_URL=postgresql://postgres.[REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres

# JWT
JWT_SECRET=troque-este-segredo-por-algo-muito-longo-e-aleatorio
JWT_EXPIRES_IN=12h

# Superadmin da plataforma (criado/atualizado pelo seed)
ADMIN_EMAIL=admin@connectbarber.app
ADMIN_PASSWORD=admin123
# Cria a "Barbearia Demo" (dono@barbeariademo.com / 123456) se true
SEED_DEMO=false

# Supabase Storage
SUPABASE_URL=https://[REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...  # Supabase → Settings → API → service_role
SUPABASE_STORAGE_BUCKET=media

# E-mail (Resend)
RESEND_API_KEY=
FROM_EMAIL=Connect Barber <noreply@seudominio.com>

# WhatsApp (Evolution API)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# Pagamentos Online Multi-Tenant (Mercado Pago OAuth)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
PAYMENT_ENCRYPTION_KEY=

# Cobrança da Plataforma
CREATIVE_PAY_BASE_URL=
CREATIVE_PAY_API_KEY=
CREATIVE_PAY_WEBHOOK_SECRET=

# Desliga as rotinas automáticas em dev
DISABLE_CRON=false
